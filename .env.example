NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
# Optional: redirect every outbound delivery email to this address instead of
# proposal.client_email. Only affects the actual Resend send — the UI,
# delivery_attempts, and readiness checks still show/use the real client
# email untouched. Useful while on Resend's sandbox sender (no verified
# domain), which can only deliver to the account's own address anyway.
RESEND_SANDBOX_RECIPIENT=

# Local dev/tests only — not read by the app itself. Used by the integration
# test suite and one-off admin scripts. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Local dev/tests only — demo account credentials used by the integration and
# e2e suites. Never commit real values here.
TEST_SALES_EMAIL=
TEST_SALES_PASSWORD=
TEST_APPROVER_EMAIL=
TEST_APPROVER_PASSWORD=
