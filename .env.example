NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESEND_API_KEY=
EMAIL_FROM=
# Optional: redirect every outbound delivery email to this address instead of
# proposal.client_email. Only affects the actual Resend send — the UI,
# delivery_attempts, and readiness checks still show/use the real client
# email untouched. Useful while on Resend's sandbox sender (no verified
# domain), which can only deliver to the account's own address anyway.
RESEND_SANDBOX_RECIPIENT=
